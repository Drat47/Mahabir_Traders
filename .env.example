# Server Port
PORT=3000

# Meta WhatsApp Cloud API Credentials (Optional - can also be configured from Admin Settings UI)
META_WA_ENABLED=true
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_WA_ACCESS_TOKEN=your_permanent_system_user_access_token_here
META_WA_WABA_ID=your_whatsapp_business_account_id_here

# Meta Approved Template Names (Optional - leave empty for direct text messages)
META_WA_TEMPLATE_WELCOME=worker_welcome_greeting
META_WA_TEMPLATE_BILL=points_credit_alert
META_WA_TEMPLATE_REDEMPTION=redemption_approved_alert
